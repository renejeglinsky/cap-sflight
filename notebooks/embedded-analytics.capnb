            }
        ]
    },
    {
        "kind": 2,
        "language": "terminal",
        "value": "npm add @sap/cds-adapter-ina-js",
        "outputs": [
            {
                "mime": "text/html",
                "value": "Running in terminal <b>embedded-analytics.capnb - /home/rjegl/github/cap-sflight/notebooks8</b>"
            }
        ]
    },
    {
        "kind": 1,
        "language": "markdown",
        "value": "Declare an analytical service",
        "outputs": []
    },
    {
        "kind": 2,
        "language": "shell",
        "value": "%%writefile \"srv/embedded-analytics.cds\"\nusing { sap.fe.cap.travel as my } from '../db/schema';\n\n\n@protocol: 'ina'\nservice FlightService {\n\nannotate my.Airline with @ObjectModel.modelingPattern: #ANALYTICAL_DIMENSION\n                         @ObjectModel.supportedCapabilities: [#ANALYTICAL_DIMENSION];\nentity FlightByAirport as select from my.Flight {\n  // dimension fields:\n  @ObjectModel.foreignKey.association: to_Airline\n  AirlineID,\n  to_Airline, \n  FlightDate,\n  ConnectionID,\n  CurrencyCode,\n\n  // measures:\n  @AnalyticsDetails.measureType: #BASE\n  Price,\n  @AnalyticsDetails.measureType: #BASE\n  MaximumSeats,\n  @AnalyticsDetails.measureType: #BASE\n  @Aggregation.default: #SUM\n  OccupiedSeats * Price as Profit : Decimal \n};\n};",
        "outputs": []
    },
    {
        "kind": 2,
        "language": "shell",
        "value": "cds add hana,mta,xsuaa,approuter --for production",
        "outputs": []
    },
    {
        "kind": 1,
        "language": "markdown",
        "value": "Freeze dependencies",
        "outputs": []
    },
    {
        "kind": 2,
        "language": "terminal",
        "value": "npm update --package-lock-only\nnpm i --prefix app/travel_analytics\nnpm i --prefix app/travel_processor",
        "outputs": []
    },
    {
        "kind": 1,
        "language": "markdown",
        "value": "Workaround (at least needed for trial):",
        "outputs": []
    },
    {
        "kind": 2,
        "language": "shell",
        "value": "%%extendjson \"xs-security.json\"\n{\"oauth2-configuration\": {\n    \"redirect-uris\": [\"https://*.us10-001.hana.ondemand.com/**\"]\n}}",
        "outputs": []
    },
    {
        "kind": 2,
        "language": "shell",
        "value": "%%extendjson \"app/router/xs-app.json\"\n{\"routes\": [           \n        {\n            \"source\": \"^/sap/bc/ina/service/v2/(.*)$\",\n            \"destination\": \"srv-api\",\n            \"authenticationType\": \"xsuaa\"\n        }\n     ]\n     }",
        "outputs": []
    },
    {
        "kind": 1,
        "language": "markdown",
        "value": "Enhance the approuter module in the  mta.yaml file according to this document:\nhttps://github.tools.sap/cap/golden-path/blob/main/deploy/with-sac/to-cf.md#build-and-deploy",
        "outputs": []

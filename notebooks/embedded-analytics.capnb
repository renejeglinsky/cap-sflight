    {
        "kind": 2,
        "language": "shell",
        "value": "%%writefile \".npmrc\"\n@sap:registry=https://int.repositories.cloud.sap/artifactory/api/npm/build-milestones-npm/\nregistry=https://int.repositories.cloud.sap/artifactory/api/npm/build-milestones-npm/",
